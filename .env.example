# Copy this file to ".env" and fill in your keys. .env is git-ignored.

# --- Free football APIs (sign up for free keys) ---
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# https://www.api-football.com/  (free tier: 100 requests/day)
API_FOOTBALL_KEY=

# --- Ollama (local, no key needed) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Token optimizer budget (per LLM call) ---
MAX_PROMPT_TOKENS=1500

# --- The Odds API (free 500 req/month) — live bookmaker odds ---
# https://the-odds-api.com
ODDS_API_KEY=
ODDS_API_SPORT=soccer_fifa_world_cup

# --- Betting discipline (value engine) ---
KELLY_FRACTION=0.25      # quarter-Kelly: standard protection vs model error
EDGE_THRESHOLD=0.03      # only flag bets with >= 3% edge after de-vig
MAX_STAKE_PCT=0.05       # never suggest more than 5% of bankroll

# --- Quant analyzer thresholds ---
# Multiclass Brier range: ~0.67 (uniform) → 0 (perfect).
# Real WC models typically reach 0.52-0.58. Set realistic stop early.
TARGET_BRIER=0.55
MAX_QUANT_ITERATIONS=6

# --- Analyst LLM (The Gaffer) ---
# Free hosted open model so the analyst works when DEPLOYED (no local Ollama).
# SIMPLE (one provider): set these three. Recommended: Cerebras (low latency).
#   Cerebras   base https://api.cerebras.ai/v1     model llama-3.3-70b (or llama3.1-8b)
#   Groq       base https://api.groq.com/openai/v1 model llama-3.3-70b-versatile
#   OpenRouter base https://openrouter.ai/api/v1   model meta-llama/llama-3.3-70b-instruct:free
LLM_API_KEY=
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=llama-3.3-70b

# FALLBACK CHAIN (optional): if a model 404s / rate-limits / errors, the next is
# tried automatically. Put your provider keys below, then list them in order.
# Entries whose key is missing are skipped, so set only the ones you have.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDERS=[{"key_env":"CEREBRAS_API_KEY","base":"https://api.cerebras.ai/v1","model":"llama-3.3-70b"},{"key_env":"CEREBRAS_API_KEY","base":"https://api.cerebras.ai/v1","model":"llama3.1-8b"},{"key_env":"OPENROUTER_API_KEY","base":"https://openrouter.ai/api/v1","model":"meta-llama/llama-3.3-70b-instruct:free"}]
